{% extends "admin/layout.njk" %}
{% block title %}Panel · Administración{% endblock %}

{% block content %}
<h1>Panel</h1>
<p class="lead-admin">Todo lo que ves en el sitio sale de aquí. Cada cambio se publica al guardar.</p>

<h2>Visitas a la portada</h2>
<div class="stats">
  <div class="stat"><span class="n">{{ stats.totalViews | numberFormat }}</span><span class="l">Visualizaciones en total</span></div>
  <div class="stat"><span class="n">{{ stats.today.views | numberFormat }}</span><span class="l">Hoy</span><span class="sub">{{ stats.today.visitors | visitors }}</span></div>
  <div class="stat"><span class="n">{{ stats.last7.views | numberFormat }}</span><span class="l">Últimos 7 días</span><span class="sub">{{ stats.last7.visitors | visitors }}</span></div>
  <div class="stat"><span class="n">{{ stats.last30.views | numberFormat }}</span><span class="l">Últimos 30 días</span><span class="sub">{{ stats.last30.visitors | visitors }}</span></div>
</div>

<table class="bars">
  <caption class="sr-only">Visualizaciones de los últimos 14 días</caption>
  <tbody>
    {% for d in stats.series %}
    <tr>
      <td>{{ d.day }}</td>
      <td class="bar-cell"><progress max="{{ stats.maxDay or 1 }}" value="{{ d.views }}">{{ d.views }}</progress></td>
      <td class="num">{{ d.views | numberFormat }} <span class="muted">({{ d.visitors | numberFormat }})</span></td>
    </tr>
    {% endfor %}
  </tbody>
</table>
<p class="help visits-note">
  Entre paréntesis, visitantes únicos del día. No cuenta robots, tus propias visitas (este navegador quedó marcado al
  iniciar sesión) ni a quien envía "No rastrear". Una persona que vuelve otro día cuenta otra vez: no se guarda nada que
  permita reconocerla de un día a otro.
</p>

<h2>Perfil</h2>
<ul class="link-list">
  <li>
    <a href="/admin/profile">Perfil</a>
    <span class="muted">{{ profile.description }}</span>
  </li>
</ul>

<h2>Contenido</h2>
<ul class="link-list">
  {% for c in cards %}
  <li>
    <a href="/admin/{{ c.slug }}">{{ c.label }}</a>
    <span class="muted">{{ c.description }}</span>
    <span class="count">{{ c.total }}</span>
  </li>
  {% endfor %}
</ul>

<h2>Respaldo</h2>
<ul class="link-list">
  <li>
    <a href="/admin/data">Importar y exportar</a>
    <span class="muted">Descarga todo el contenido en un archivo JSON o reemplázalo con uno.</span>
  </li>
</ul>
{% endblock %}
