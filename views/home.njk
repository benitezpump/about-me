{% extends "layout.njk" %}

{% macro period(p) -%}
  {%- if p.label -%}{{ p.label }}
  {%- else -%}{{ p.from }} – {% if p.current %}<span class="now">actualidad</span>{% else %}{{ p.to }}{% endif %}
  {%- endif -%}
{%- endmacro %}

{% macro details(p) -%}
  {%- if p.highlights.length -%}
  <details>
    <summary>Ver detalle</summary>
    <ul>
      {%- for h in p.highlights %}
      <li>{% if h.label %}<strong>{{ h.label }}:</strong> {% endif %}{{ h.body }}</li>
      {%- endfor %}
    </ul>
  </details>
  {%- endif -%}
{%- endmacro %}

{% macro extlink(url, text) -%}
  <a href="{{ url }}"{% if url | isHttp %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ text }}</a>
{%- endmacro %}

{% block body %}
<a class="skip" href="#inicio">Saltar al contenido</a>

<header class="top">
  <div class="wrap">
    <a class="brand" href="#inicio">{{ profile.displayName }}</a>
    <nav aria-label="Secciones">
      {% if work.length %}<a href="#trabajo">Trabajo</a>{% endif %}
      {% if teaching.length %}<a href="#docencia">Docencia</a>{% endif %}
      {% if personalProjects.length %}<a href="#proyectos">Proyectos</a>{% endif %}
      {% if education.length or certificationGroups.length %}<a href="#formacion">Formación</a>{% endif %}
      <a href="#contacto">Contacto</a>
      <button class="theme" type="button" aria-label="Cambiar a tema claro">
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
      </button>
    </nav>
  </div>
</header>

<main id="inicio">

  <section class="hero">
    <div class="wrap">
      <div class="hero-main">
        <h1><span>{{ profile.firstNames }}</span><span>{{ profile.lastNames }}</span></h1>
        <p class="role">{{ profile.headline }}</p>
        {% for paragraph in profile.intro %}<p class="lead">{{ paragraph }}</p>
        {% endfor %}
        <div class="cta">
          {% if profile.ctaUrl %}<a class="btn" href="{{ profile.ctaUrl }}"{% if profile.ctaUrl | isHttp %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ profile.ctaLabel }}</a>{% endif %}
          {% if work.length %}<a class="more" href="#trabajo">Ver mi trabajo</a>{% endif %}
        </div>
      </div>

      {% if now.length %}
      <aside class="now-panel" aria-labelledby="h-ahora">
        <h2 id="h-ahora">Actualmente</h2>
        {% for n in now %}
        <div class="item">
          <p class="when">{{ n.sinceLabel }}</p>
          <p><strong>{{ n.title }}</strong>{% if n.body %} {{ n.body }}{% endif %}</p>
        </div>
        {% endfor %}
      </aside>
      {% endif %}
    </div>
  </section>

  {% if toolGroups.length %}
  <section class="sec" aria-labelledby="herramientas">
    <div class="wrap">
      <h2 id="herramientas">Herramientas</h2>
      <dl class="rows tools">
        {% for g in toolGroups %}
        <div{% if g.emphasis %} class="emphasis"{% endif %}>
          <dt>{{ g.label }}</dt>
          <dd>{{ g.tools | join(", ") }}.</dd>
        </div>
        {% endfor %}
      </dl>
    </div>
  </section>
  {% endif %}

  {% if work.length %}
  <section class="sec" id="trabajo" aria-labelledby="h-trabajo">
    <div class="wrap">
      <h2 id="h-trabajo">Trabajo</h2>
      <div>
        {% for e in work %}
        <div class="exp">
          <p class="intro"><strong>{{ e.role }} en {% if e.article %}{{ e.article }} {% endif %}{{ e.company }}</strong>{% if e.location %}, {{ e.location }}{% endif %}{% if e.since %}, desde {{ e.since }}{% endif %}.{% if e.projects.length %} Proyectos del más reciente al más antiguo:{% endif %}</p>
          {% if e.projects.length %}
          <button class="expand" type="button" aria-expanded="false">Expandir todo</button>
          <ol class="timeline">
            {% for p in e.projects %}
            <li{% if p.period.current %} class="current"{% endif %}>
              <p class="when">{{ period(p.period) }}</p>
              <h3>{{ p.title }}</h3>
              {% if p.description %}<p class="desc">{{ p.description }}</p>{% endif %}
              {{ details(p) }}
              {% if p.stack %}<p class="stack">{{ p.stack }}</p>{% endif %}
            </li>
            {% endfor %}
          </ol>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if teaching.length %}
  <section class="sec" id="docencia" aria-labelledby="h-docencia">
    <div class="wrap">
      <h2 id="h-docencia">Docencia</h2>
      <div>
        {% for e in teaching %}
        <div class="exp">
          <p class="intro"><strong>{{ e.role }} en {% if e.article %}{{ e.article }} {% endif %}{{ e.company }}</strong>{% if e.location %}, {{ e.location }}{% endif %}{% if e.since %}, desde {{ e.since }}{% endif %}.</p>

          {% if e.courses.length %}
          <div class="group">
            <dl class="rows">
              {% for c in e.courses %}<div><dt>{{ period(c.period) }}</dt><dd>{{ c.subject }}</dd></div>
              {% endfor %}
            </dl>
          </div>
          {% endif %}

          {% if e.workshops.length %}
          <div class="group">
            {% if e.workshopsTitle %}<h3>{{ e.workshopsTitle }}</h3>{% endif %}
            <dl class="rows">
              {% for w in e.workshops %}<div><dt>{{ w.label }}</dt><dd>{{ w.name }}</dd></div>
              {% endfor %}
            </dl>
          </div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if personalProjects.length %}
  <section class="sec" id="proyectos" aria-labelledby="h-proyectos">
    <div class="wrap">
      <h2 id="h-proyectos">Proyectos propios</h2>
      <div>
        {% for p in personalProjects %}
        <article class="project">
          <p class="when">{{ period(p.period) }}</p>
          <h3>{{ p.title }}</h3>
          {% if p.description %}<p class="desc">{{ p.description }}</p>{% endif %}
          {% if p.highlights.length %}
          <ul>
            {% for h in p.highlights %}<li>{% if h.label %}<strong>{{ h.label }}:</strong> {% endif %}{{ h.body }}</li>
            {% endfor %}
          </ul>
          {% endif %}
          {% if p.stack %}<p class="stack">{{ p.stack }}</p>{% endif %}
        </article>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if education.length or certificationGroups.length %}
  <section class="sec" id="formacion" aria-labelledby="h-formacion">
    <div class="wrap">
      <h2 id="h-formacion">Formación</h2>
      <div>
        {% if education.length %}
        <div class="group">
          <dl class="rows">
            {% for e in education %}<div><dt>{{ e.periodLabel }}</dt><dd><strong class="strong-text">{{ e.title }}</strong>{% if e.institution %}, {{ e.institution }}{% endif %}.</dd></div>
            {% endfor %}
          </dl>
        </div>
        {% endif %}

        {% for g in certificationGroups %}
        <div class="group">
          <h3>{{ g.title }}</h3>
          <dl class="rows">
            {% for c in g.items %}<div><dt>{{ c.year }}</dt><dd>{% if c.url %}{{ extlink(c.url, c.name) }}{% else %}{{ c.name }}{% endif %}{% if c.issuer %}, {{ c.issuer }}{% endif %}.{% if c.note %} {{ c.note }}{% endif %}</dd></div>
            {% endfor %}
          </dl>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  <section class="sec" id="contacto" aria-labelledby="h-contacto">
    <div class="wrap">
      <h2 id="h-contacto">Contacto</h2>
      <div>
        {% if profile.contactPrompt %}<p class="intro">{{ profile.contactPrompt }}</p>{% endif %}
        {% if profile.ctaUrl %}<p class="contact-mail">{{ extlink(profile.ctaUrl, profile.ctaLabel) }}</p>{% endif %}
        {% if profile.location or contactLinks.length %}
        <dl class="rows contact-rows">
          {% if profile.location %}<div><dt>Ubicación</dt><dd>{{ profile.location }}</dd></div>{% endif %}
          {% for l in contactLinks %}<div><dt>{{ l.label }}</dt><dd>{{ extlink(l.url, l.url | displayUrl) }}</dd></div>
          {% endfor %}
        </dl>
        {% endif %}
      </div>
    </div>
  </section>

</main>

<footer class="foot">
  <div class="wrap foot-row">
    <span>© {{ year }} {{ profile.firstNames }} {{ profile.lastNames }}</span>
    {% if viewsLabel %}<span class="views"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>{{ viewsLabel }}</span>{% endif %}
  </div>
</footer>
{% endblock %}
