{
  "name": "about-me",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sitio personal con contenido en PostgreSQL y panel de administración.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env src/cli/seed.ts",
    "seed:force": "tsx --env-file-if-exists=.env src/cli/seed.ts --force",
    "catalog:import": "tsx --env-file-if-exists=.env src/cli/import-catalog.ts",
    "admin:create": "tsx --env-file-if-exists=.env src/cli/create-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "fastify": "^5.12.5",
    "nunjucks": "^3.2.4",
    "pg": "^8.23.0",
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/node": "^22.20.4",
    "@types/nunjucks": "^3.2.6",
    "@types/pg": "^8.23.1",
    "@types/qs": "^6.15.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
