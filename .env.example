# Copia este archivo a .env y ajusta los valores. .env NUNCA se sube al repositorio.

# --- Base de datos: elige UNA de las dos opciones -------------------------------------------------

# Opción A: ya tienes una base PostgreSQL (servidor propio, Neon, Supabase, Railway, RDS…).
# Pega aquí su URL. Si es un servicio en la nube, casi siempre necesita "?sslmode=require" al final.
# DATABASE_URL=postgres://usuario:clave@host:5432/nombre_de_la_base?sslmode=require
#
# Supabase: usa el "Session pooler" (puerto 5432, usuario postgres.<ref>), no la conexión directa (solo IPv6) ni el modo
# transacción (6543). Y su certificado (CA), que Node no trae y sin el cual `sslmode=require` falla al verificar:
# DATABASE_URL=postgres://postgres.<ref>:<contraseña>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----"   # el certificado completo
# Guía: README, "Desplegar en Render con la base en Supabase".

# Opción B: que Docker Compose levante una PostgreSQL local. Descomenta las dos líneas
# y usa solo letras y números en la clave (va dentro de una URL).
# COMPOSE_PROFILES=local-db
# POSTGRES_PASSWORD=cambia-esto-por-una-clave-larga

# --- Aplicación ----------------------------------------------------------------------------------
# Administrador inicial (se crea al primer arranque si aún no existe ninguno). Mínimo 12 caracteres.
ADMIN_USERNAME=carlos
ADMIN_PASSWORD=cambia-esto-por-una-clave-larga
APP_PORT=3000
# Conexiones máximas a la base. Baja a 3–5 si tu plan de base de datos limita las conexiones.
DB_POOL_MAX=10
# Ponlo en true cuando el sitio se sirva por HTTPS (marca las cookies como Secure).
# Con "true" el login NO funciona por http:// salvo en localhost.
COOKIE_SECURE=false
# Cuántos proxies de confianza hay delante de la app, para leer la IP real del visitante (de ella dependen el límite
# de intentos de login y el contador de visitas únicas). Valores: false | un número (1, 2…) | lista de IP/CIDR.
# EVITA `true`: confía en todos los saltos y un visitante puede falsificar su IP. En Render empieza con 1 (README).
TRUST_PROXY=false

# --- Desarrollo local sin Docker (npm run dev:db  +  npm run dev) ---------------------------------
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
# DB_POOL_MAX=1
# SEED_ON_EMPTY=true
# PORT=3000
