# Copia este archivo a .env y ajusta los valores. .env NUNCA se sube al repositorio.
# Con Docker Compose también se lee de aquí (ver docker-compose.yml). Sin Docker: php artisan serve.

# --- Aplicación --------------------------------------------------------------------------------------------------
APP_NAME="Sitio personal"
# local para desarrollo; production en el servidor.
APP_ENV=local
# Cifra las cookies y las sesiones. Genérala con:  php artisan key:generate --show   (empieza con base64:)
# Si la cambias, se cierran todas las sesiones abiertas. En producción va como secreto, nunca en el repositorio.
APP_KEY=
# true SOLO en desarrollo: en producción mostraría variables de entorno y consultas en las páginas de error.
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Base de datos: PostgreSQL ------------------------------------------------------------------------------------
# Opción A: ya tienes una base PostgreSQL (servidor propio, Neon, Supabase, Railway, RDS…). Pega aquí su URL.
# La aplicación acepta DB_URL o DATABASE_URL (la que usan Render y Compose).
DB_URL=postgres://usuario:clave@127.0.0.1:5432/postgres
#
# Supabase: usa el "Session pooler" (puerto 5432, usuario postgres.<ref>), no la conexión directa (solo IPv6) ni el modo
# transacción (6543, rompe las sentencias preparadas de PDO):
# DB_URL=postgres://postgres.<ref>:<contraseña>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Y su certificado (CA): con él la conexión se cifra Y se verifica al servidor (sslmode=verify-full).
# Supabase → Database settings → SSL Configuration → Download certificate. Es un certificado público.
# Con la CA, sslmode es verify-full (verifica la cadena Y el nombre del servidor). Si la conexión falla solo por el nombre
# del servidor, DB_SSLMODE=verify-ca verifica la cadena sin el nombre (menos estricto, pero sigue verificando la CA):
# DB_SSLMODE=verify-ca
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----"
#
# Opción B: que Docker Compose levante una PostgreSQL local. Descomenta las dos líneas y usa solo letras y números en
# la clave (va dentro de una URL).
# COMPOSE_PROFILES=local-db
# POSTGRES_PASSWORD=cambia-esto-por-una-clave-larga

# Migra el esquema al arrancar el contenedor (con bloqueo: dos instancias no migran a la vez).
RUN_MIGRATIONS=true
# Carga el contenido inicial si la base está vacía: el tuyo (database/seed/content.json) si existe; si no, el de EJEMPLO.
SEED_ON_EMPTY=true

# --- Administrador inicial -----------------------------------------------------------------------------------------
# Se crea al arrancar si aún no existe (php artisan admin:ensure). Mínimo 12 caracteres. No pisa una contraseña que ya
# cambiaste desde el panel.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esto-por-una-clave-larga

# --- Seguridad -------------------------------------------------------------------------------------------------------
# Cookies solo por HTTPS (y HSTS). Actívalo siempre detrás de HTTPS; con true el login NO funciona por http://.
SESSION_SECURE_COOKIE=false
# Cuántos proxies de confianza hay delante de la app, para leer la IP real del visitante (de ella dependen el límite de
# intentos de login y el contador de visitas únicas). Valores: vacío (ninguno) | un número (1, 2…) | lista de IP/CIDR.
# EVITA `true`: confía en todos los saltos y un visitante puede falsificar su IP. En Render empieza con 1 (README).
TRUST_PROXY=
# Intentos de login permitidos por IP cada 15 minutos.
LOGIN_MAX_ATTEMPTS=10

# --- Ajustes opcionales ---------------------------------------------------------------------------------------------
# Vida en segundos del contenido público en caché (cada edición desde el panel la invalida al instante).
CONTENT_CACHE_TTL=60
# Zona horaria que define cuándo empieza un "día" en el contador de visitas.
STATS_TIMEZONE=America/Hermosillo
# Las sesiones viven en la base (tabla web_sessions): el contenedor de Render es efímero.
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
